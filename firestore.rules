rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function roleOf(uid) {
      return userDoc(uid).data.role;
    }

    function isAdmin() {
      return signedIn() && (roleOf(request.auth.uid) == 'admin' || roleOf(request.auth.uid) == 'root-admin');
    }

    function isRootAdmin() {
      return signedIn() && roleOf(request.auth.uid) == 'root-admin';
    }

    function hasOnly(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isRootAdmin();

      allow create: if
        isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.role == 'student';

      allow create, update, delete: if isRootAdmin();

      allow update: if
        isOwner(userId) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role;
    }

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /tests/{testId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow create: if
        signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow get: if
        signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      allow list: if
        signedIn() &&
        (
          isAdmin() ||
          resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /leaderboardPublic/{rowId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /testAttempts/{attemptId} {
      allow create: if
        signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow get: if
        signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if
        signedIn() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow get: if signedIn();
      allow list: if signedIn();

      allow create: if
        signedIn() &&
        request.resource.data.createdBy == request.auth.uid;

      allow update, delete: if
        signedIn() &&
        (
          resource.data.createdBy == request.auth.uid ||
          isAdmin()
        );
    }

    match /courses/{courseId} {
      allow get, list: if
        signedIn() &&
        (
          isAdmin() ||
          resource.data.isPublished == true
        );
      allow create, update, delete: if isAdmin();
    }

    match /courseSessions/{sessionId} {
      allow create: if
        signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow get, list: if
        signedIn() &&
        (
          isAdmin() ||
          resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /courseEnrollmentsPublic/{enrollmentId} {
      allow get, list: if signedIn();

      allow create: if
        signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userId is string &&
        request.resource.data.courseId is string &&
        request.resource.data.createdAt is string &&
        enrollmentId == (request.resource.data.courseId + '_' + request.auth.uid);

      allow update, delete: if isAdmin();
    }

    match /licenseKeys/{keyId} {
      allow get: if signedIn();
      allow list: if isRootAdmin();
      allow create, update, delete: if isRootAdmin();
    }

    match /questionTagInsights/{tagId} {
      allow create: if
        signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow get, list: if
        signedIn() &&
        (
          isAdmin() ||
          resource.data.userId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /broadcastNotifications/{notificationId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /brainstormMembers/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if
        isOwner(userId) &&
        request.resource.data.userId == request.auth.uid;

      allow update: if
        isOwner(userId) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.strikeCount >= resource.data.strikeCount &&
        (
          resource.data.blacklisted == true
          ? request.resource.data.blacklisted == true
          : true
        );

      allow delete: if isAdmin();
    }

    match /brainstormCheckins/{checkinId} {
      allow get: if
        signedIn() &&
        (
          isAdmin() ||
          resource == null ||
          resource.data.userId == request.auth.uid
        );

      allow list: if isAdmin();

      allow create, update: if
        signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow delete: if isAdmin();
    }

    match /brainstormBlacklist/{userId} {
      allow get, list: if true;

      allow create: if
        isOwner(userId) &&
        request.resource.data.userId == request.auth.uid;

      allow update: if
        isOwner(userId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.strikeCount >= resource.data.strikeCount;

      allow delete: if isAdmin();
    }

    match /brainstormConfig/{configId} {
      allow get, list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /aiQuestionExplanations/{cacheId} {
      allow read: if signedIn();

      allow create, update: if
        signedIn() &&
        hasOnly(['cacheKey', 'questionId', 'questionSignature', 'explanation', 'model', 'updatedAt']) &&
        request.resource.data.questionId is string &&
        request.resource.data.questionSignature is string &&
        request.resource.data.explanation is string &&
        request.resource.data.model is string &&
        request.resource.data.updatedAt is string;

      allow delete: if isAdmin();
    }
  }
}
